# 前端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# API基础URL（可选，默认为相对路径 /api/v1）
VITE_API_BASE_URL=http://localhost:8088

# 加密密钥（可选）
# 如果设置，所有API请求和响应将使用AES-256-GCM加密
# 生成密钥命令: openssl rand -base64 32
# 示例: VITE_ENCRYPTION_KEY=AbCdEf1234567890GhIjKlMnOpQrStUvWxYz0123456789ABC=
# 注意：前端和后端必须使用相同的密钥
VITE_ENCRYPTION_KEY=

# 应用标题（可选，会覆盖从后端获取的标题）
VITE_APP_TITLE=敏感词检测系统
